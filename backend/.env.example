# Copie este arquivo para .env e substitua os valores de exemplo.
# Não versione o arquivo .env nem compartilhe a senha do banco.
DATABASE_URL=postgresql+asyncpg://postgres:SUA_SENHA@localhost:5432/radar_tech
JWT_SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
